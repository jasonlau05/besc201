{
  "name": "group9-elon",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "test:ev": "node client/scripts/check-ev-deconstruction.mjs",
    "client": "npm run dev -w client",
    "server": "npm run dev -w server",
    "test:chargers": "node --test client/src/chargers-client.test.mjs client/src/google-maps.test.mjs server/src/charger-data.test.js server/src/chargers.test.js server/scripts/refresh-chargers.test.mjs",
    "refresh:chargers": "node server/scripts/refresh-chargers.mjs",
    "dev": "concurrently -n \"CLIENT,SERVER\" -c \"cyan,green\" \"npm run client\" \"npm run server\"",
    "start": "npm run dev"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
