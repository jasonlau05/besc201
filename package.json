{
  "name": "group9-elon",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n CLIENT,SERVER -c cyan,green npm:dev:*",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "start": "npm run dev",
    "test": "node --test \"client/src/**/*.test.mjs\" \"server/src/*.test.js\" \"server/scripts/*.test.mjs\""
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
