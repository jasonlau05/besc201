{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/learn",
          "destination": "/learn.html"
        },
        {
          "source": "/info",
          "destination": "/info.html"
        },
        {
          "source": "/chargers",
          "destination": "/chargers.html"
        },
        {
          "source": "/chat",
          "destination": "/chat.html"
        }
      ]
    },
    "server": {
      "root": "server",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client"
      }
    }
  ]
}
